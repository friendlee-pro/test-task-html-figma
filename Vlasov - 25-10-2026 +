import noUiSlider from 'nouislider';
import './../scss/main.scss';

// Константы
const MIN_CAR_COST = 1500000;
const MAX_CAR_COST = 10000000;
const MIN_DOWN_PAYMENT_PERCENT = 10;
const MAX_DOWN_PAYMENT_PERCENT = 60;
const MIN_TERM = 6;
const MAX_TERM = 120;
const INTEREST_RATE = 0.05;

// Элементы
const form = document.getElementById('calculator-form');
const carCostInput = document.getElementById('car-cost');
const downPaymentInput = document.getElementById('down-payment');
const leaseTermInput = document.getElementById('lease-term');
const downPaymentPercent = document.querySelector('.range-field__percent');
const monthlyPaymentVal = document.getElementById('monthly-payment');
const totalAmountVal = document.getElementById('total-amount');
const submitBtn = document.getElementById('submit-btn');

// Инициализация значений (как в Фигме)
let state = {
  carCost: 3000000,
  downPayment: 600000,
  leaseTerm: 60
};

// Утилиты
const formatCurrency = (num) => new Intl.NumberFormat('ru-RU').format(num);
const parseCurrency = (str) => parseInt(str.replace(/\s/g, '').replace('₽', ''), 10) || 0;

// Расчеты
const calculate = () => {
  const { carCost, downPayment, leaseTerm } = state;
  const amountToFinance = carCost - downPayment;

  // Формула аннуитетного платежа
  const pow = Math.pow(1 + INTEREST_RATE, leaseTerm);
  const monthly = amountToFinance * (INTEREST_RATE * pow / (pow - 1));
  
  const total = downPayment + monthly * leaseTerm;

  monthlyPaymentVal.textContent = `${formatCurrency(Math.round(monthly))} ₽`;
  totalAmountVal.textContent = `${formatCurrency(Math.round(total))} ₽`;
};

// Слайдеры
const initSliders = () => {
  // Стоимость авто
  noUiSlider.create(carCostInput.nextElementSibling, {
    start: state.carCost,
    connect: [true, false],
    range: { 'min': MIN_CAR_COST, 'max': MAX_CAR_COST },
    step: 100000,
    format: { to: v => Math.round(v), from: v => Math.round(v) }
  });

  // Первоначальный взнос (в процентах)
  noUiSlider.create(downPaymentInput.nextElementSibling.nextElementSibling, {
    start: (state.downPayment / state.carCost) * 100,
    connect: [true, false],
    range: { 'min': MIN_DOWN_PAYMENT_PERCENT, 'max': MAX_DOWN_PAYMENT_PERCENT },
    step: 1
  });

  // Срок
  noUiSlider.create(leaseTermInput.nextElementSibling.nextElementSibling, {
    start: state.leaseTerm,
    connect: [true, false],
    range: { 'min': MIN_TERM, 'max': MAX_TERM },
    step: 1
  });

  // Обработчики
  carCostInput.nextElementSibling.noUiSlider.on('update', (values) => {
    state.carCost = parseInt(values[0], 10);
    // Ограничиваем взнос, если стоимость авто уменьшилась
    if (state.downPayment > state.carCost * (MAX_DOWN_PAYMENT_PERCENT / 100)) {
      state.downPayment = state.carCost * (MAX_DOWN_PAYMENT_PERCENT / 100);
      downPaymentInput.value = formatCurrency(state.downPayment);
      downPaymentInput.nextElementSibling.nextElementSibling.noUiSlider.set((state.downPayment / state.carCost) * 100);
    }
    carCostInput.value = formatCurrency(state.carCost);
    calculate();
  });

  downPaymentInput.nextElementSibling.nextElementSibling.noUiSlider.on('update', (values) => {
    const percent = parseInt(values[0], 10);
    state.downPayment = Math.round(state.carCost * (percent / 100));
    downPaymentInput.value = formatCurrency(state.downPayment);
    downPaymentPercent.textContent = `${percent}%`;
    calculate();
  });

  leaseTermInput.nextElementSibling.nextElementSibling.noUiSlider.on('update', (values) => {
    state.leaseTerm = parseInt(values[0], 10);
    leaseTermInput.value = state.leaseTerm;
    calculate();
  });
};

// Ввод с клавиатуры
const bindInputs = () => {
  const handleInput = (input, slider, setState, validateFn) => {
    input.addEventListener('input', (e) => {
      let value = parseCurrency(e.target.value);
      value = validateFn(value);
      setState(value);
      slider.noUiSlider.set(value);
    });
  };

  handleInput(carCostInput, carCostInput.nextElementSibling, (v) => {
    v = Math.max(MIN_CAR_COST, Math.min(MAX_CAR_COST, v));
    state.carCost = v;
    // Пересчитываем слайдер взноса в %
    downPaymentInput.nextElementSibling.nextElementSibling.noUiSlider.set((state.downPayment / state.carCost) * 100);
    return v;
  }, v => v);

  handleInput(downPaymentInput, downPaymentInput.nextElementSibling.nextElementSibling, (v) => {
    const max = state.carCost * (MAX_DOWN_PAYMENT_PERCENT / 100);
    const min = state.carCost * (MIN_DOWN_PAYMENT_PERCENT / 100);
    v = Math.max(min, Math.min(max, v));
    state.downPayment = v;
    downPaymentPercent.textContent = `${Math.round((v / state.carCost) * 100)}%`;
    return v;
  }, v => v);

  handleInput(leaseTermInput, leaseTermInput.nextElementSibling.nextElementSibling, (v) => {
    return Math.max(MIN_TERM, Math.min(MAX_TERM, v));
  }, v => v);
};

// Отправка формы
form.addEventListener('submit', (e) => {
  e.preventDefault();
  submitBtn.disabled = true;
  submitBtn.textContent = 'Заявка отправлена';

  const payload = {
    carCost: state.carCost,
    downPayment: state.downPayment,
    leaseTerm: state.leaseTerm,
    monthlyPayment: parseInt(monthlyPaymentVal.textContent.replace(/\D/g, '')),
    totalAmount: parseInt(totalAmountVal.textContent.replace(/\D/g, ''))
  };

  console.log(JSON.stringify(payload, null, 2));
  // Здесь может быть fetch() на ваш бэкенд
});

// Запуск
initSliders();
bindInputs();
calculate();
